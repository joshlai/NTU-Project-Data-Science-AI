  ANY_VALUE(ema_50) AS ema_50,
  ANY_VALUE(rsi_14) AS rsi_14,
  ANY_VALUE(sma_50) AS sma_50
FROM dup_data 
GROUP BY ticker_symbol, date
    );
  
