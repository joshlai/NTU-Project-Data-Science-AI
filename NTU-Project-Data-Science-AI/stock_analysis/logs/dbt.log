  ta.sma_50
FROM `dsai-project-462603`.`stock_analysis`.`combined_tickers` t
LEFT JOIN `dsai-project-462603`.`stock_analysis`.`fred` f
  ON DATE(t.date) = DATE(f.date)
LEFT JOIN `dsai-project-462603`.`stock_analysis`.`stock_info` i
  ON t.ticker_symbol = i.ticker_symbol AND DATE(t.date) BETWEEN '2025-04-01' AND '2025-06-30'
